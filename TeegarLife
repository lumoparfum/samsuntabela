function doLogin(){
  const v = document.getElementById('pinInput').value;
  const err = document.getElementById('loginErr');
  if(v === PIN){
    if(document.getElementById('rememberMe').checked){
      const exp = Date.now()+7*24*3600*1000;
      localStorage.setItem('tl_session', exp.toString());
    }
    startApp();
  } else {
    err.textContent='Hatalı şifre. Tekrar dene.';
    document.getElementById('pinInput').value='';
    setTimeout(()=>err.textContent='',2500);
  }
}
document.getElementById('pinInput').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});

function checkSession(){
  const exp=localStorage.getItem('tl_session');
