<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="TeegarLife"/>
<meta name="theme-color" content="#060B18"/>
<title>TeegarLife – Yıldızın Gibi Parla</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
<style>
/* ══════════════════════════════════════
   TOKENS
══════════════════════════════════════ */
:root{
  --bg:       #060B18;
  --bg2:      #0D1526;
  --bg3:      #131E35;
  --card:     #111827;
  --border:   rgba(255,255,255,.07);
  --text:     #EEF2FF;
  --text2:    #A5B4D4;
  --text3:    #5B6E90;
  --gold:     #FFD166;
  --gold2:    #F4A832;
  --blue:     #4F8EF7;
  --green:    #2DD4BF;
  --red:      #F87171;
  --orange:   #FB923C;
  --purple:   #A78BFA;
  --star:     #FFD166;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overscroll-behavior:none;}
body{
  font-family:'Space Grotesk',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100dvh;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}
input,select,textarea{font-family:inherit;}
::-webkit-scrollbar{width:0;background:transparent;}

/* ══════════════════════════════════════
   STARFIELD
══════════════════════════════════════ */
#starfield{
  position:fixed;top:0;left:0;width:100%;height:100%;
  pointer-events:none;z-index:0;
}

/* ══════════════════════════════════════
   LOGIN
══════════════════════════════════════ */
#loginScreen{
  position:fixed;inset:0;z-index:9999;
  display:flex;align-items:center;justify-content:center;
  background:var(--bg);
  flex-direction:column;gap:0;
}
.login-wrap{
  width:92%;max-width:360px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:32px;
  padding:40px 32px 36px;
  text-align:center;
  box-shadow:0 0 60px rgba(79,142,247,.12);
}
.login-star{font-size:3.5rem;line-height:1;margin-bottom:12px;animation:starPulse 3s ease-in-out infinite;}
@keyframes starPulse{0%,100%{text-shadow:0 0 20px #FFD16688;}50%{text-shadow:0 0 50px #FFD166cc,0 0 80px #FFD16644;}}
.login-logo{font-size:2rem;font-weight:700;letter-spacing:-.5px;margin-bottom:4px;}
.login-logo span{color:var(--gold);}
.login-tagline{font-size:.82rem;color:var(--text3);margin-bottom:32px;}
.login-input{
  width:100%;padding:14px 18px;
  background:var(--bg2);border:1px solid var(--border);
  border-radius:50px;color:var(--text);font-size:1rem;
  text-align:center;letter-spacing:4px;margin-bottom:8px;
  transition:border-color .2s;
}
.login-input:focus{outline:none;border-color:var(--gold);}
.login-remember{display:flex;align-items:center;gap:8px;justify-content:center;margin-bottom:20px;font-size:.82rem;color:var(--text3);}
.login-remember input{accent-color:var(--gold);width:16px;height:16px;}
.login-btn{
  width:100%;padding:14px;border-radius:50px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  color:#0D1526;font-weight:700;font-size:1rem;
  transition:all .2s;box-shadow:0 4px 20px rgba(255,209,102,.25);
}
.login-btn:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(255,209,102,.35);}
.login-err{font-size:.78rem;color:var(--red);margin-top:8px;min-height:18px;}

/* ══════════════════════════════════════
   APP SHELL
══════════════════════════════════════ */
#app{display:none;flex-direction:column;min-height:100dvh;position:relative;z-index:1;}
#app.visible{display:flex;}

/* ══════════════════════════════════════
   HEADER
══════════════════════════════════════ */
.header{
  display:flex;justify-content:space-between;align-items:center;
  padding:max(16px,env(safe-area-inset-top)) 20px 12px;
}
.header-logo{font-size:1.3rem;font-weight:700;color:var(--gold);}
.header-logo span{color:var(--text3);font-weight:400;}
.icon-btn{
  width:38px;height:38px;border-radius:50%;
  background:var(--card);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;transition:all .2s;
}
.icon-btn:hover{border-color:var(--gold);background:var(--bg3);}

/* ══════════════════════════════════════
   BOTTOM NAV
══════════════════════════════════════ */
.bottom-nav{
  display:flex;
  background:var(--card);
  border-top:1px solid var(--border);
  padding:8px 0 max(8px,env(safe-area-inset-bottom));
  position:sticky;bottom:0;z-index:100;
}
.nav-item{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
  font-size:.65rem;font-weight:600;color:var(--text3);padding:4px 0;
  transition:color .2s;
}
.nav-item .nav-ico{font-size:1.4rem;transition:transform .2s;}
.nav-item.active{color:var(--gold);}
.nav-item.active .nav-ico{transform:scale(1.15);}

/* ══════════════════════════════════════
   PAGES
══════════════════════════════════════ */
.page{display:none;flex:1;overflow-y:auto;padding-bottom:20px;animation:pageIn .25s ease;}
.page.active{display:block;}
@keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ══════════════════════════════════════
   CARDS / SHARED
══════════════════════════════════════ */
.card{
  background:var(--card);border:1px solid var(--border);
  border-radius:24px;margin:12px 16px;padding:18px;
}
.section-label{
  font-size:.68rem;font-weight:700;letter-spacing:.08em;
  text-transform:uppercase;color:var(--text3);margin:20px 20px 8px;
}
.pill-badge{
  display:inline-block;padding:3px 10px;border-radius:20px;
  font-size:.65rem;font-weight:700;
}
.pill-green{background:rgba(45,212,191,.15);color:var(--green);}
.pill-gold{background:rgba(255,209,102,.15);color:var(--gold);}
.pill-red{background:rgba(248,113,113,.15);color:var(--red);}
.pill-blue{background:rgba(79,142,247,.15);color:var(--blue);}

/* ══════════════════════════════════════
   HOME PAGE — STAR WIDGET
══════════════════════════════════════ */
.star-widget{
  text-align:center;padding:28px 20px 20px;position:relative;
  overflow:hidden;
}
.star-core{
  position:relative;display:inline-block;margin-bottom:16px;
  cursor:default;
}
.star-svg{
  width:120px;height:120px;
  filter:drop-shadow(0 0 20px rgba(255,209,102,.5));
  animation:starSpin 20s linear infinite;
}
@keyframes starSpin{from{filter:drop-shadow(0 0 18px rgba(255,209,102,.4));}50%{filter:drop-shadow(0 0 40px rgba(255,209,102,.8));}to{filter:drop-shadow(0 0 18px rgba(255,209,102,.4));}}
.star-day-badge{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-family:'Space Mono',monospace;
  font-size:1.6rem;font-weight:700;color:var(--gold);
  text-shadow:0 0 20px var(--gold);
  pointer-events:none;
}
.star-day-label{font-size:.65rem;color:var(--text3);margin-top:-4px;}
.star-quote{
  font-size:.88rem;color:var(--text2);
  max-width:300px;margin:0 auto;line-height:1.6;
  font-style:italic;
}

/* ══════════════════════════════════════
   BAĞIMLILIK KARTLARI
══════════════════════════════════════ */
.dep-cards{display:flex;flex-direction:column;gap:0;}
.dep-card{
  display:flex;align-items:center;gap:14px;
  margin:0 16px 10px;padding:16px;
  background:var(--card);border:1px solid var(--border);
  border-radius:20px;transition:all .2s;position:relative;overflow:hidden;
}
.dep-card::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:4px;
  border-radius:4px 0 0 4px;
}
.dep-card[data-type="sigara"]::before{background:var(--orange);}
.dep-card[data-type="alkol"]::before{background:var(--blue);}
.dep-card[data-type="31"]::before{background:var(--purple);}
.dep-card[data-type="kumar"]::before{background:var(--green);}
.dep-card[data-type="yeme"]::before{background:var(--red);}
.dep-icon{font-size:2rem;width:48px;text-align:center;flex-shrink:0;}
.dep-info{flex:1;min-width:0;}
.dep-name{font-weight:700;font-size:.95rem;margin-bottom:2px;}
.dep-days{
  font-family:'Space Mono',monospace;
  font-size:1.5rem;font-weight:700;color:var(--gold);line-height:1;
}
.dep-sub{font-size:.68rem;color:var(--text3);margin-top:2px;}
.dep-actions{display:flex;flex-direction:column;gap:6px;flex-shrink:0;}
.dep-btn{
  padding:6px 12px;border-radius:30px;font-size:.68rem;font-weight:700;
  transition:all .2s;
}
.dep-btn-relapse{
  background:rgba(248,113,113,.15);color:var(--red);
  border:1px solid rgba(248,113,113,.2);
}
.dep-btn-relapse:hover{background:rgba(248,113,113,.25);}
.dep-btn-crisis{
  background:rgba(79,142,247,.15);color:var(--blue);
  border:1px solid rgba(79,142,247,.2);
}
.dep-btn-crisis:hover{background:rgba(79,142,247,.25);}

/* ══════════════════════════════════════
   NET WORTH / SAVINGS
══════════════════════════════════════ */
.savings-row{display:flex;gap:10px;margin:0 16px 10px;}
.savings-box{
  flex:1;background:var(--card);border:1px solid var(--border);
  border-radius:20px;padding:14px;text-align:center;
}
.savings-box .s-label{font-size:.65rem;color:var(--text3);margin-bottom:4px;}
.savings-box .s-value{font-size:1.2rem;font-weight:700;color:var(--green);}
.savings-box .s-sub{font-size:.6rem;color:var(--text3);margin-top:2px;}

/* ══════════════════════════════════════
   ADD ADDICTION PAGE
══════════════════════════════════════ */
.add-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:12px;
  padding:0 16px;
}
.add-type-card{
  background:var(--card);border:2px solid var(--border);
  border-radius:20px;padding:20px 14px;text-align:center;
  cursor:pointer;transition:all .25s;
}
.add-type-card:hover,.add-type-card.selected{
  border-color:var(--gold);background:var(--bg3);
  box-shadow:0 0 20px rgba(255,209,102,.1);
}
.add-type-card .at-icon{font-size:2.2rem;margin-bottom:8px;}
.add-type-card .at-name{font-weight:700;font-size:.9rem;}
.add-type-card .at-desc{font-size:.72rem;color:var(--text3);margin-top:4px;}

/* ══════════════════════════════════════
   FORM ELEMENTS
══════════════════════════════════════ */
.form-card{background:var(--card);border:1px solid var(--border);border-radius:24px;margin:12px 16px;padding:20px;}
.form-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);display:block;margin-bottom:8px;}
.form-input{
  width:100%;padding:12px 16px;
  background:var(--bg2);border:1px solid var(--border);
  border-radius:50px;color:var(--text);font-size:.95rem;
  transition:border-color .2s;
}
.form-input:focus{outline:none;border-color:var(--gold);}
.form-group{margin-bottom:16px;}
.btn-primary{
  width:100%;padding:15px;border-radius:50px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  color:#0D1526;font-weight:700;font-size:1rem;
  transition:all .2s;box-shadow:0 4px 20px rgba(255,209,102,.2);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(255,209,102,.3);}
.btn-danger{
  width:100%;padding:13px;border-radius:50px;margin-top:10px;
  background:rgba(248,113,113,.12);color:var(--red);
  border:1px solid rgba(248,113,113,.2);font-weight:700;
}
.btn-ghost{
  width:100%;padding:13px;border-radius:50px;margin-top:8px;
  background:transparent;color:var(--text3);
  border:1px solid var(--border);font-weight:600;
}

/* ══════════════════════════════════════
   STATS PAGE — CALENDAR
══════════════════════════════════════ */
.cal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.cal-nav{background:var(--bg2);border:1px solid var(--border);border-radius:30px;padding:6px 14px;font-size:.8rem;font-weight:600;color:var(--text);}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
.cal-day-label{text-align:center;font-size:.6rem;font-weight:700;color:var(--text3);padding:4px 0;}
.cal-day{
  aspect-ratio:1;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:.7rem;font-weight:600;color:var(--text3);
  transition:all .2s;cursor:default;
}
.cal-day.clean{background:rgba(45,212,191,.2);color:var(--green);}
.cal-day.relapse{background:rgba(248,113,113,.2);color:var(--red);}
.cal-day.today{border:2px solid var(--gold);color:var(--gold);}
.cal-day.empty{opacity:0;}

/* ══════════════════════════════════════
   STATS — CHARTS (CSS BAR CHARTS)
══════════════════════════════════════ */
.bar-chart{display:flex;align-items:flex-end;gap:6px;height:100px;margin-top:8px;}
.bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;}
.bar{
  width:100%;border-radius:6px 6px 0 0;
  background:linear-gradient(to top,var(--gold2),var(--gold));
  min-height:4px;transition:height .5s ease;
}
.bar-label{font-size:.55rem;color:var(--text3);text-align:center;}

/* ══════════════════════════════════════
   ROZET SAYFASI
══════════════════════════════════════ */
.badge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:0 16px;}
.badge-item{
  background:var(--card);border:1px solid var(--border);
  border-radius:20px;padding:16px 10px;text-align:center;
  transition:all .25s;position:relative;
}
.badge-item.earned{
  border-color:rgba(255,209,102,.4);
  box-shadow:0 0 20px rgba(255,209,102,.1);
}
.badge-item.locked{opacity:.4;filter:grayscale(.8);}
.badge-emoji{font-size:2.2rem;margin-bottom:8px;display:block;}
.badge-name{font-size:.72rem;font-weight:700;margin-bottom:3px;}
.badge-req{font-size:.6rem;color:var(--text3);}
.badge-earned-mark{
  position:absolute;top:8px;right:8px;
  font-size:.6rem;background:var(--gold);color:#0D1526;
  border-radius:20px;padding:2px 6px;font-weight:700;
}

/* ══════════════════════════════════════
   GÜNLÜK SAYFA
══════════════════════════════════════ */
.mood-row{display:flex;gap:8px;justify-content:center;margin-bottom:16px;}
.mood-btn{
  font-size:1.8rem;width:52px;height:52px;border-radius:50%;
  background:var(--bg2);border:2px solid var(--border);
  transition:all .2s;
}
.mood-btn.selected{border-color:var(--gold);transform:scale(1.15);background:rgba(255,209,102,.1);}
.journal-entry{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:16px;padding:14px;margin-bottom:10px;
}
.journal-entry .je-date{font-size:.65rem;color:var(--text3);margin-bottom:6px;}
.journal-entry .je-mood{font-size:1.1rem;margin-bottom:4px;}
.journal-entry .je-text{font-size:.85rem;color:var(--text2);line-height:1.5;}

/* ══════════════════════════════════════
   MODALS (OVERLAY)
══════════════════════════════════════ */
.modal{
  position:fixed;inset:0;z-index:5000;
  background:rgba(0,0,0,.7);backdrop-filter:blur(8px);
  display:none;align-items:flex-end;justify-content:center;
}
.modal.center{align-items:center;}
.modal.show{display:flex;animation:modalIn .25s ease;}
@keyframes modalIn{from{opacity:0}to{opacity:1}}
.modal-box{
  background:var(--card);border:1px solid var(--border);
  border-radius:32px 32px 24px 24px;
  width:100%;max-width:500px;padding:24px 20px;
  max-height:90dvh;overflow-y:auto;
  animation:slideUp .25s ease;
}
.modal.center .modal-box{border-radius:28px;width:92%;}
@keyframes slideUp{from{transform:translateY(40px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.modal-title{font-size:1.15rem;font-weight:700;}
.modal-close{font-size:1.8rem;color:var(--text3);line-height:1;padding:0 4px;}

/* ══════════════════════════════════════
   NEFES EGZERSİZİ
══════════════════════════════════════ */
.breath-wrap{text-align:center;padding:20px 0;}
.breath-circle{
  width:140px;height:140px;border-radius:50%;
  background:radial-gradient(circle,rgba(79,142,247,.3),rgba(79,142,247,.05));
  border:2px solid rgba(79,142,247,.4);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 20px;font-size:1rem;font-weight:700;color:var(--blue);
  transition:transform 4s ease;
}
.breath-circle.inhale{transform:scale(1.6);}
.breath-circle.exhale{transform:scale(1);}
.breath-instruction{font-size:1.1rem;font-weight:700;color:var(--blue);margin-bottom:8px;}
.breath-counter{font-size:.85rem;color:var(--text3);}

/* ══════════════════════════════════════
   KRİZ MODU
══════════════════════════════════════ */
.crisis-options{display:flex;flex-direction:column;gap:12px;}
.crisis-opt{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:20px;padding:16px;display:flex;align-items:center;gap:14px;
  cursor:pointer;transition:all .2s;
}
.crisis-opt:hover{border-color:var(--blue);background:var(--bg3);}
.crisis-opt .co-icon{font-size:1.8rem;flex-shrink:0;}
.crisis-opt .co-title{font-weight:700;font-size:.95rem;margin-bottom:3px;}
.crisis-opt .co-desc{font-size:.75rem;color:var(--text3);}

/* ══════════════════════════════════════
   MINI GAME — TAP GAME
══════════════════════════════════════ */
.tap-game{text-align:center;padding:10px 0;}
.tap-target{
  width:100px;height:100px;border-radius:50%;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  display:flex;align-items:center;justify-content:center;
  font-size:2.5rem;margin:0 auto 16px;
  cursor:pointer;transition:transform .1s;
  box-shadow:0 4px 20px rgba(255,209,102,.3);
  user-select:none;
}
.tap-target:active{transform:scale(.9);}
.tap-score{font-size:2rem;font-weight:700;color:var(--gold);font-family:'Space Mono',monospace;}
.tap-label{font-size:.8rem;color:var(--text3);}
.tap-timer{font-size:1rem;color:var(--text2);margin-top:8px;}

/* ══════════════════════════════════════
   CONFETTI
══════════════════════════════════════ */
.confetti-container{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9998;}
.confetti-piece{position:absolute;width:10px;height:10px;top:-10px;border-radius:2px;animation:confettiFall 2.5s linear forwards;}
@keyframes confettiFall{to{transform:translateY(110vh) rotate(720deg);opacity:0;}}

/* ══════════════════════════════════════
   TOAST
══════════════════════════════════════ */
.toast{
  position:fixed;bottom:calc(80px + env(safe-area-inset-bottom));
  left:16px;right:16px;
  background:var(--card);border:1px solid var(--border);
  color:var(--text);padding:13px 18px;
  border-radius:40px;text-align:center;z-index:9999;
  font-size:.88rem;font-weight:600;
  animation:toastIn .3s ease;
  box-shadow:0 4px 20px rgba(0,0,0,.4);
}
@keyframes toastIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}

/* ══════════════════════════════════════
   SETTINGS PAGE
══════════════════════════════════════ */
.setting-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:15px 16px;margin:0 16px 8px;
  background:var(--card);border:1px solid var(--border);border-radius:18px;
}
.setting-left{display:flex;align-items:center;gap:12px;}
.setting-icon{font-size:1.2rem;}
.setting-label{font-weight:600;font-size:.9rem;}
.setting-action{background:none;border:none;color:var(--blue);font-weight:700;font-size:.85rem;}
.setting-action.danger{color:var(--red);}

/* ══════════════════════════════════════
   EMPTY STATE
══════════════════════════════════════ */
.empty-state{text-align:center;padding:48px 24px;}
.empty-state .e-icon{font-size:3.5rem;margin-bottom:12px;opacity:.5;}
.empty-state p{font-size:.88rem;color:var(--text3);line-height:1.6;}

/* ══════════════════════════════════════
   SPINNER
══════════════════════════════════════ */
.spinner{
  position:fixed;inset:0;z-index:9998;
  background:rgba(6,11,24,.7);backdrop-filter:blur(4px);
  display:none;align-items:center;justify-content:center;
}
.spinner.show{display:flex;}
.spinner-dot{
  width:12px;height:12px;border-radius:50%;background:var(--gold);
  animation:spinnerDot 1.4s ease-in-out infinite;
}
.spinner-dot:nth-child(2){animation-delay:.2s;margin:0 8px;}
.spinner-dot:nth-child(3){animation-delay:.4s;}
@keyframes spinnerDot{0%,80%,100%{transform:scale(0);opacity:.3}40%{transform:scale(1);opacity:1}}

