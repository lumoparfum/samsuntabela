function calNav(dir){calMonth+=dir;if(calMonth<0){calMonth=11;calYear--;}if(calMonth>11){calMonth=0;calYear++;}renderStats();}
function buildCalendar(a){
  const y=calYear,m=calMonth;
  const firstDay=new Date(y,m,1).getDay();
  const daysInMonth=new Date(y,m+1,0).getDate();
  const today=new Date();
  const relapseSet=new Set((a.relapses||[]).map(r=>r.date));
  const startDate=new Date(a.startDate);
  startDate.setHours(0,0,0,0);
  const days=['Pzt','Sal','Çar','Per','Cum','Cmt','Paz'];
  let html='<div class="cal-grid">';
  days.forEach(d=>html+=`<div class="cal-day-label">${d}</div>`);
  // offset (Mon=0)
  const offset=(firstDay===0?6:firstDay-1);
  for(let i=0;i<offset;i++) html+=`<div class="cal-day empty"></div>`;
  for(let d=1;d<=daysInMonth;d++){
    const dateStr=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isToday=today.getFullYear()===y&&today.getMonth()===m&&today.getDate()===d;
    const isRelapse=relapseSet.has(dateStr);
    const dayDate=new Date(dateStr); dayDate.setHours(0,0,0,0);
    const isClean=dayDate>=startDate&&!isRelapse;
    let cls='cal-day';
    if(isToday) cls+=' today';
    else if(isRelapse) cls+=' relapse';
    else if(isClean) cls+=' clean';
    html+=`<div class="${cls}">${d}</div>`;
  }
  html+='</div>';
  return html;
}
function buildBarChart(a){
  const relapseSet=new Set((a.relapses||[]).map(r=>r.date));
  const startDate=new Date(a.startDate);startDate.setHours(0,0,0,0);
  const days=['Pzt','Sal','Çar','Per','Cum','Cmt','Paz','Bugün'];
  let html='<div class="bar-chart">';
  for(let i=6;i>=0;i--){
    const d=new Date(); d.setDate(d.getDate()-i); d.setHours(0,0,0,0);
    const ds=d.toISOString().slice(0,10);
    const isClean=d>=startDate&&!relapseSet.has(ds);
    const isToday=i===0;
    html+=`<div class="bar-wrap">
      <div class="bar" style="height:${isClean?'80':'8'}px;background:${isClean?'linear-gradient(to top,var(--gold2),var(--gold))':'rgba(248,113,113,.4)'};"></div>
      <div class="bar-label">${['Pzt','Sal','Çar','Per','Cum','Cmt','Paz'][d.getDay()===0?6:d.getDay()-1]}</div>
    </div>`;
  }
  html+='</div>';
  return html;
}

