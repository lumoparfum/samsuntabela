function checkBadges(){
  const newBadges=[];
  const maxDays=addictions.length?Math.max(...addictions.map(a=>daysSince(a.startDate))):0;
  const journalDays=new Set(journals.map(j=>j.date)).size;
  BADGE_DEF.forEach(b=>{
    if(earnedBadges.includes(b.id)) return;
    let earn=false;
    if(b.special==='added'&&addictions.length>0) earn=true;
    else if(b.special==='journal7'&&journalDays>=7) earn=true;
    else if(b.special==='crisis1'&&crisisUsed) earn=true;
    else if(!b.special&&b.days>0&&maxDays>=b.days) earn=true;
    if(earn){earnedBadges.push(b.id);newBadges.push(b);}
  });
  if(newBadges.length){
    save();
    newBadges.forEach((b,i)=>{
      setTimeout(()=>{
        fireConfetti();
        showToast('🏆 Yeni rozet: '+b.emoji+' '+b.name,'var(--gold)');
      },i*600);
    });
  }
}
