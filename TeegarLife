  document.querySelectorAll('.mood-btn').forEach(b=>b.classList.remove('selected'));
  renderJournal();
  showToast('📔 Günlük kaydedildi!','var(--green)');
}
function renderJournal(){
  const list=document.getElementById('journalList');
  list.innerHTML='';
  if(!journals.length){
    list.innerHTML='<div class="empty-state"><div class="e-icon">📔</div><p>Henüz günlük yok.<br>Bugün nasıl hissediyorsun?</p></div>';
    return;
  }
  journals.slice(0,20).forEach(j=>{
    const div=document.createElement('div');
    div.className='journal-entry';
    div.innerHTML=`<div class="je-date">${fmtDate(j.date)}</div><div class="je-mood">${j.mood}</div><div class="je-text">${j.text}</div>`;
    list.appendChild(div);
  });
}

// ══════════════════════════════════════
// AYARLAR
// ══════════════════════════════════════
function clearAllData(){
  if(!confirm('Tüm veriler silinecek. Emin misin?')) return;
  localStorage.clear();
  addictions=[];journals=[];earnedBadges=[];crisisUsed=false;
  save();renderHome();renderBadges();renderJournal();
  showToast('Veriler silindi.','var(--red)');
}

